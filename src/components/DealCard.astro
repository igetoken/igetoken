---
import type { Deal, DealType } from '../lib/types';
import { DEAL_TYPE_LABEL, daysLeft } from '../lib/data';
import Badge from './Badge.astro';

interface Props {
  deal: Deal;
  showSummary?: boolean;
}
const { deal, showSummary = false } = Astro.props;
const left = deal.status === 'active' ? daysLeft(deal.deadline) : null;
const typeLabel = DEAL_TYPE_LABEL[deal.type as DealType] ?? '情报';
const showEnding = deal.status === 'active' && typeof left === 'number' && left > 0 && left <= 7;
const endingLabel = `剩 ${left} 天`;
---

<a
  href={`/deals/${deal.id}/`}
  class:list={[
    'block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-emerald-300 hover:shadow-md',
    deal.status === 'ended' && 'opacity-70',
  ]}
>
  <div class="flex flex-wrap items-center gap-2">
    <span class="rounded-md bg-emerald-600/10 px-2 py-0.5 text-xs font-medium text-emerald-700">
      {deal.platform_name}
    </span>
    <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-600">{typeLabel}</span>
    {deal.status === 'ended' && <Badge variant="ended" label="已结束" />}
    {showEnding && <Badge variant="ending" label={endingLabel} />}
    {deal.type === 'limited_time' && deal.status === 'active' && <Badge variant="hot" label="限时" />}
  </div>
  <h3 class="mt-3 font-semibold leading-snug text-slate-900">{deal.title}</h3>
  <p class="mt-1.5 text-sm text-emerald-700">{deal.reward}</p>
  {showSummary && <p class="mt-2 line-clamp-2 text-sm text-slate-500">{deal.summary}</p>}
  <p class="mt-3 text-xs text-slate-400">发布于 {deal.date}</p>
</a>
