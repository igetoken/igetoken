---
import type { Perk } from '../lib/types';
import { PERK_TYPE_LABEL } from '../lib/data';

interface Props {
  perk: Perk;
}
const { perk } = Astro.props;

const typeLabel = PERK_TYPE_LABEL[perk.type] ?? '福利';
const recurrenceLabel: Record<string, string> = { daily: '每日', weekly: '每周', once: '一次性' };
const recLabel = recurrenceLabel[perk.recurrence] ?? '';
const deadlineText = perk.deadline ? `截止 ${perk.deadline}` : '长期可领';
const verifiedShort = perk.last_verified.slice(5).replace('-', '/');
---

<a
  href={perk.source}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex flex-col rounded-xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-md"
>
  <div class="flex flex-wrap items-center gap-2">
    <span class="rounded-md bg-slate-900 px-2 py-0.5 text-xs font-semibold text-white">{perk.product}</span>
    <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-600">{typeLabel}</span>
    <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-medium text-red-600 ring-1 ring-red-200">
      不可导出为 API
    </span>
  </div>

  <h3 class="mt-3 font-semibold leading-snug text-slate-900 group-hover:text-amber-700">{perk.title}</h3>
  <p class="mt-1.5 text-sm font-medium text-emerald-700">{perk.amount}</p>
  <p class="mt-2 text-sm text-slate-500">{perk.condition}</p>

  <div class="mt-3 flex flex-wrap gap-x-2 gap-y-1 text-xs text-slate-400">
    <span>{recLabel}</span>
    <span>·</span>
    <span>{deadlineText}</span>
    <span>·</span>
    <span>{perk.validity}</span>
  </div>

  <p class="mt-3 border-t border-slate-100 pt-3 text-xs leading-relaxed text-slate-400">{perk.note}</p>

  <div class="mt-3 flex items-center justify-between">
    <span class="text-xs text-slate-400">{verifiedShort} 已核实</span>
    <span class="text-sm font-semibold text-amber-700">官方领取 →</span>
  </div>
</a>
