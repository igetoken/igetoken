---
import type { Platform } from '../lib/types';
import Badge from './Badge.astro';

interface Props {
  platform: Platform;
}
const { platform: p } = Astro.props;
const verifiedShort = p.last_verified.slice(5).replace('-', '/');
---

<a
  href={`/models/${p.slug}/`}
  class="group flex flex-col rounded-xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md"
>
  <div class="flex items-start justify-between gap-2">
    <h3 class="font-bold text-slate-900 group-hover:text-emerald-700">{p.name}</h3>
    <Badge variant="verified" label={`${verifiedShort} 已核实`} />
  </div>
  <p class="mt-2 line-clamp-2 text-sm text-slate-500">{p.tagline}</p>
  <p class="mt-3 text-sm font-medium text-emerald-700">{p.highlight}</p>
  <div class="mt-3 flex flex-wrap gap-1.5">
    {
      p.tags.map((t) => (
        <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-600">{t}</span>
      ))
    }
  </div>
</a>
