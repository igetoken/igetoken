---
const nav = [
  { href: '/', label: '首页' },
  { href: '/models/', label: '资源库' },
  { href: '/deals/', label: '活动快讯' },
  { href: '/tutorials/', label: '教程' },
  { href: '/guide/', label: '避坑指南' },
  { href: '/about/', label: '关于' },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4">
    <a href="/" class="flex items-center gap-2 text-lg font-bold text-slate-900">
      <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-600 text-sm font-black text-white">iG</span>
      <span>iGetToken</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm transition',
              isActive(item.href)
                ? 'bg-emerald-50 font-semibold text-emerald-700'
                : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="relative md:hidden">
      <summary class="flex cursor-pointer list-none items-center rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">
        菜单
      </summary>
      <nav class="absolute right-0 mt-2 w-44 rounded-xl border border-slate-200 bg-white p-2 shadow-lg">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'block rounded-lg px-3 py-2 text-sm',
                isActive(item.href)
                  ? 'bg-emerald-50 font-semibold text-emerald-700'
                  : 'text-slate-600 hover:bg-slate-100',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
