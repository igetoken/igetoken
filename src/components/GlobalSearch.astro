---
// 站内全局搜索：Header 集成，一次搜全 4 栏（资源库 / 活动快讯 / 积分福利 / 搜索 API）。
// 零依赖客户端模糊匹配；索引由 prebuild 生成于 /search-index.json，运行时懒加载（不增加首屏体积）。
// 交互：点击触发 / 快捷键「/」或 Ctrl(⌘)+K 打开，ESC 关闭，↑↓ 选择，Enter 跳转。
---

<div id="gs-root" class="relative">
  <button
    id="gs-trigger"
    type="button"
    aria-label="站内搜索"
    class="flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-sm text-slate-500 transition hover:border-emerald-300 hover:text-emerald-700"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-4 w-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7" />
      <path d="m21 21-4.3-4.3" />
    </svg>
    <span class="hidden lg:inline">搜索</span>
    <kbd
      class="hidden rounded border border-slate-300 bg-white px-1.5 text-[10px] font-medium text-slate-400 lg:inline"
      >/</kbd
    >
  </button>

  <div id="gs-overlay" class="fixed inset-0 z-[60] hidden" role="dialog" aria-modal="true" aria-label="站内搜索">
    <div id="gs-backdrop" class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm"></div>
    <div id="gs-panel" class="relative mx-auto mt-[8vh] w-[94%] max-w-2xl md:mt-[12vh]">
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
        <div class="flex items-center gap-3 border-b border-slate-100 px-4">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 shrink-0 text-slate-400"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7" />
            <path d="m21 21-4.3-4.3" />
          </svg>
          <input
            id="gs-input"
            type="text"
            placeholder="搜索平台 / 活动快讯 / 积分福利 / 搜索 API…"
            class="h-14 w-full bg-transparent text-slate-900 placeholder:text-slate-400 focus:outline-none"
            autocomplete="off"
            spellcheck="false"
          />
          <kbd class="hidden rounded border border-slate-300 bg-slate-50 px-1.5 py-0.5 text-[10px] text-slate-400 sm:inline"
            >ESC</kbd
          >
        </div>
        <div id="gs-results" class="max-h-[58vh] min-h-[96px] overflow-y-auto p-2"></div>
      </div>
      <p class="mt-3 text-center text-xs text-slate-400">
        <span class="text-slate-300">↑↓ 选择 · Enter 跳转 · ESC 关闭</span>
      </p>
    </div>
  </div>
</div>

<script>
  const root = document.getElementById('gs-root');
  if (root) {
    const trigger = root.querySelector('#gs-trigger');
    const overlay = root.querySelector('#gs-overlay');
    const backdrop = root.querySelector('#gs-backdrop');
    const input = root.querySelector('#gs-input');
    const resultsEl = root.querySelector('#gs-results');

    // ⚠️ Header 带 backdrop-blur（backdrop-filter），会为 position:fixed 的后代建立「包含块」，
    // 使浮层的 fixed inset-0 被限制在导航栏高度（约 56px）内。将浮层外挂到 <body> 才能全屏。
    // 注意：必须在取到内部元素引用之后再移动，否则 root.querySelector 会失配。
    if (overlay.parentElement !== document.body) document.body.appendChild(overlay);

    const GROUPS = {
      platform: { label: '资源库', color: 'bg-emerald-600' },
      deal: { label: '活动快讯', color: 'bg-orange-500' },
      perk: { label: '积分福利', color: 'bg-amber-500' },
      search: { label: '搜索 API', color: 'bg-indigo-500' },
    };
    const ORDER = ['platform', 'deal', 'perk', 'search'];
    const PER_GROUP = 6;

    let index = null;
    let loading = null;
    let flat = [];
    let activeIdx = -1;

    async function ensureIndex() {
      if (index) return index;
      if (!loading) {
        loading = fetch('/search-index.json', { cache: 'force-cache' })
          .then((r) => (r.ok ? r.json() : []))
          .catch(() => [])
          .then((data) => {
            index = Array.isArray(data) ? data : [];
            return index;
          });
      }
      return loading;
    }

    function scoreRec(rec, tokens) {
      const title = (rec.title || '').toLowerCase();
      let total = 0;
      for (const t of tokens) {
        let s;
        if (title === t) s = 200;
        else if (title.startsWith(t)) s = 140;
        else if (title.includes(t)) s = 100;
        else if ((rec.tags || []).some((g) => g.toLowerCase().includes(t))) s = 60;
        else if ((rec.hay || '').includes(t)) s = 40;
        else return 0;
        total += s;
      }
      if (rec.status === 'ended') total -= 25;
      return total;
    }

    function runSearch(q) {
      const query = q.trim().toLowerCase();
      if (!query || !index) return [];
      const tokens = query.split(/\s+/).filter(Boolean);
      const scored = [];
      for (const rec of index) {
        const s = scoreRec(rec, tokens);
        if (s > 0) scored.push({ rec, s });
      }
      scored.sort((a, b) => b.s - a.s);
      const groups = [];
      for (const key of ORDER) {
        const items = scored
          .filter((x) => x.rec.t === key)
          .map((x) => x.rec)
          .slice(0, PER_GROUP);
        if (items.length) groups.push({ key, items });
      }
      return groups;
    }

    function showState(text) {
      resultsEl.innerHTML = '';
      const div = document.createElement('div');
      div.className = 'px-3 py-8 text-center text-sm text-slate-400';
      div.textContent = text;
      resultsEl.appendChild(div);
      flat = [];
      activeIdx = -1;
    }

    function render(groups, q) {
      if (!q.trim()) {
        showState('输入关键词，搜索平台 / 活动快讯 / 积分福利 / 搜索 API');
        return;
      }
      if (!groups.length) {
        showState('未找到相关结果，换个关键词试试');
        return;
      }
      resultsEl.innerHTML = '';
      flat = [];
      activeIdx = -1;
      for (const g of groups) {
        const meta = GROUPS[g.key];
        const head = document.createElement('div');
        head.className = 'px-3 pb-1 pt-3 text-xs font-semibold tracking-wide text-slate-400';
        head.textContent = meta.label;
        resultsEl.appendChild(head);

        for (const rec of g.items) {
          const a = document.createElement('a');
          a.className = 'gs-item flex items-start gap-3 rounded-lg px-3 py-2 hover:bg-slate-50';
          a.href = rec.url;
          if (rec.ext) {
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
          }
          const badge = document.createElement('span');
          badge.className = `mt-0.5 shrink-0 rounded px-1.5 py-0.5 text-[10px] font-semibold text-white ${meta.color}`;
          badge.textContent = meta.label;
          const body = document.createElement('span');
          body.className = 'min-w-0 flex-1';
          const title = document.createElement('span');
          title.className = 'block truncate text-sm font-medium text-slate-900';
          title.textContent = rec.title;
          body.appendChild(title);
          if (rec.sub) {
            const sub = document.createElement('span');
            sub.className = 'block truncate text-xs text-slate-500';
            sub.textContent = rec.sub;
            body.appendChild(sub);
          }
          a.appendChild(badge);
          a.appendChild(body);
          if (rec.status === 'ended') {
            const end = document.createElement('span');
            end.className = 'mt-0.5 shrink-0 rounded bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-500';
            end.textContent = '已结束';
            a.appendChild(end);
          } else if (rec.ext) {
            const ext = document.createElement('span');
            ext.className = 'mt-0.5 shrink-0 text-[10px] text-slate-300';
            ext.textContent = '↗';
            a.appendChild(ext);
          }
          resultsEl.appendChild(a);
          flat.push(a);
        }
      }
    }

    function setActive(i) {
      if (!flat.length) return;
      activeIdx = (i + flat.length) % flat.length;
      flat.forEach((el, idx) => el.classList.toggle('bg-slate-100', idx === activeIdx));
      flat[activeIdx].scrollIntoView({ block: 'nearest' });
    }

    function open(initial) {
      overlay.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      input.value = initial || '';
      activeIdx = -1;
      ensureIndex().then(() => {
        if (input.value) render(runSearch(input.value), input.value);
        else showState('输入关键词，搜索平台 / 活动快讯 / 积分福利 / 搜索 API');
      });
      requestAnimationFrame(() => input.focus());
    }

    function close() {
      overlay.classList.add('hidden');
      document.body.style.overflow = '';
    }

    const isOpen = () => !overlay.classList.contains('hidden');

    trigger.addEventListener('click', () => open());
    backdrop.addEventListener('click', close);

    let debounce;
    input.addEventListener('input', () => {
      clearTimeout(debounce);
      const q = input.value;
      debounce = setTimeout(async () => {
        await ensureIndex();
        render(runSearch(q), q);
      }, 80);
    });

    document.addEventListener('keydown', (e) => {
      const el = e.target;
      const tag = el && el.tagName;
      const typing = tag === 'INPUT' || tag === 'TEXTAREA' || (el && el.isContentEditable);
      if ((e.key === '/' && !typing) || ((e.metaKey || e.ctrlKey) && String(e.key).toLowerCase() === 'k')) {
        e.preventDefault();
        open();
        return;
      }
      if (!isOpen()) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(activeIdx + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(activeIdx - 1);
      } else if (e.key === 'Enter' && activeIdx >= 0 && flat[activeIdx]) {
        e.preventDefault();
        flat[activeIdx].click();
      }
    });

    // 深链：/?q=关键词 或 #search 直接打开搜索（便于分享 / 收藏搜索结果链接）
    const urlQ = new URLSearchParams(location.search).get('q');
    if (urlQ) open(urlQ);
    else if (location.hash === '#search') open();
  }
</script>
