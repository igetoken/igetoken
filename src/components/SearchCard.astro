---
import type { SearchApi } from '../lib/types';
import { SEARCH_TYPE_LABEL } from '../lib/data';

interface Props {
  api: SearchApi;
}
const { api } = Astro.props;

const typeLabel = SEARCH_TYPE_LABEL[api.type] ?? '免费';
const hasMcp = api.interfaces.includes('MCP');
const recurrenceLabel: Record<string, string> = { monthly: '每月重置', daily: '每日', once: '一次性' };
const recLabel = recurrenceLabel[api.recurrence] ?? '';
const deadlineText = api.deadline ? `限时至 ${api.deadline}` : '长期免费';
const verifiedShort = api.last_verified.slice(5).replace('-', '/');
---

<a
  href={api.source}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex flex-col rounded-xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md"
>
  <div class="flex flex-wrap items-center gap-2">
    <span class="rounded-md bg-slate-900 px-2 py-0.5 text-xs font-semibold text-white">{api.product}</span>
    <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-600">{typeLabel}</span>
    {
      hasMcp && (
        <span class="rounded-md bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-600">MCP</span>
      )
    }
  </div>

  <h3 class="mt-3 font-semibold leading-snug text-slate-900 group-hover:text-emerald-700">{api.title}</h3>
  <p class="mt-1.5 text-sm font-medium text-emerald-700">{api.amount}</p>

  <div class="mt-3 grid grid-cols-1 gap-2 text-sm">
    <div class="flex items-start gap-2 text-slate-500">
      <span class="mt-0.5 shrink-0 font-medium text-slate-400">认证</span>
      <span>{api.auth}</span>
    </div>
    <div class="flex items-start gap-2 text-slate-500">
      <span class="mt-0.5 shrink-0 font-medium text-slate-400">接入</span>
      <span class="flex flex-wrap gap-1">
        {
          api.interfaces.map((i) => (
            <span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">{i}</span>
          ))
        }
      </span>
    </div>
    {
      api.rate_limit && (
        <div class="flex items-start gap-2 text-slate-500">
          <span class="mt-0.5 shrink-0 font-medium text-slate-400">限流</span>
          <span>{api.rate_limit}</span>
        </div>
      )
    }
  </div>

  <div class="mt-3 flex flex-wrap gap-x-2 gap-y-1 text-xs text-slate-400">
    <span>{recLabel}</span>
    <span>·</span>
    <span>{deadlineText}</span>
  </div>

  <p class="mt-3 border-t border-slate-100 pt-3 text-xs leading-relaxed text-slate-400">{api.note}</p>

  <div class="mt-3 flex items-center justify-between">
    <span class="text-xs text-slate-400">{verifiedShort} 已核实</span>
    <span class="text-sm font-semibold text-emerald-700">官方文档 →</span>
  </div>
</a>
