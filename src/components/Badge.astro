---
interface Props {
  variant: 'verified' | 'hot' | 'ending' | 'ended' | 'evergreen' | 'new';
  label: string;
}
const { variant, label } = Astro.props;
const styles: Record<Props['variant'], string> = {
  verified: 'bg-emerald-50 text-emerald-700 ring-emerald-200',
  hot: 'bg-red-50 text-red-600 ring-red-200',
  ending: 'bg-amber-50 text-amber-700 ring-amber-200',
  ended: 'bg-slate-100 text-slate-500 ring-slate-200',
  evergreen: 'bg-slate-100 text-slate-600 ring-slate-300',
  new: 'bg-sky-50 text-sky-700 ring-sky-200',
};
---

<span class:list={['inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium ring-1', styles[variant]]}>
  {label}
</span>
