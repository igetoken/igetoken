---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import Callout from '../../components/Callout.astro';
import StarRating from '../../components/StarRating.astro';
import DealCard from '../../components/DealCard.astro';
import { getPlatforms, getPlatformBySlug, getDealsByPlatform, OFFER_TYPE_LABEL, CATEGORY_LABEL } from '../../lib/data';

export function getStaticPaths() {
  return getPlatforms().map((platform) => ({
    params: { slug: platform.slug },
    props: { platform },
  }));
}

const { platform } = Astro.props as { platform: ReturnType<typeof getPlatformBySlug> };
const relatedDeals = getDealsByPlatform(platform.slug);
const activeDeals = relatedDeals.filter((d) => d.status !== 'ended');
const endedDeals = relatedDeals.filter((d) => d.status === 'ended');
const all = getPlatforms();
const idx = all.findIndex((p) => p.slug === platform.slug);
const prev = all[(idx - 1 + all.length) % all.length];
const next = all[(idx + 1) % all.length];
const verifiedShort = platform.last_verified.replace(/-/g, '/');

const isOpenAI = platform.openai_compatible !== false;

const curlExample = isOpenAI
  ? `curl ${platform.api_base}/chat/completions \\
  -H "Content-Type: application/json" \\
  -H "Authorization: Bearer $API_KEY" \\
  -d '{
    "model": "${platform.example_model}",
    "messages": [{"role": "user", "content": "你好，介绍一下你自己"}]
  }'`
  : `# 该平台使用官方自有协议，不支持 cURL 直连
# 接入端点：${platform.api_base}
# 完整文档：${platform.docs_url}`;

const pythonExample = isOpenAI
  ? `from openai import OpenAI
import os

client = OpenAI(
    api_key=os.environ["API_KEY"],
    base_url="${platform.api_base}",
)

resp = client.chat.completions.create(
    model="${platform.example_model}",
    messages=[{"role": "user", "content": "你好，介绍一下你自己"}],
)
print(resp.choices[0].message.content)`
  : (platform.sdk_example ?? `# 该平台需使用官方 SDK 调用，详见 ${platform.docs_url}`);

// 右侧目录（TOC）：与下方区块渲染同源，条件区块自动出现/消失
const toc = [
  { id: 'offers', label: '额度速览' },
  { id: 'steps', label: '领取步骤' },
  platform.api_base ? { id: 'usage', label: '怎么用' } : null,
  platform.extra_endpoints && platform.extra_endpoints.length > 0 ? { id: 'endpoints', label: '附加端点' } : null,
  platform.devAgent ? { id: 'devagent', label: '官方开发工具' } : null,
  { id: 'pitfalls', label: '坑点提醒' },
  activeDeals.length > 0 ? { id: 'active', label: '进行中活动' } : null,
  endedDeals.length > 0 ? { id: 'archived', label: '历史活动' } : null,
].filter(Boolean);

---

<Base
  title={`${platform.name} 免费 Token 领取攻略（2026 最新） | iGetToken`}
  description={`${platform.name}：${platform.highlight}。附领取步骤、调用示例、坑点提醒，最后核实于 ${verifiedShort}。`}
>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-10">
      <section class="min-w-0">
    <nav class="text-sm text-slate-400">
      <a href="/models/" class="hover:text-emerald-700">资源库</a>
      <span class="mx-1">/</span>
      <span class="text-slate-600">{CATEGORY_LABEL[platform.category]}</span>
    </nav>

    <!-- 头部 -->
    <div class="mt-4 flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-black text-slate-900">{platform.name}</h1>
        <p class="mt-2 text-slate-500">{platform.tagline}</p>
        {
          platform.rating ? (
            <div class="mt-3 flex flex-wrap items-center gap-2">
              <StarRating rating={platform.rating} label />
              {platform.ratingNote && <span class="text-sm text-slate-500">{platform.ratingNote}</span>}
            </div>
          ) : null
        }
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <Badge variant="verified" label={`${verifiedShort} 已核实`} />
        <a
          href={platform.website}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700"
        >
          前往官方平台 ↗
        </a>
      </div>
    </div>

    <!-- 额度速览 -->
    <h2 id="offers" class="mt-10 scroll-mt-24 text-xl font-bold text-slate-900">额度速览</h2>
    <div class="mt-4 overflow-hidden rounded-xl border border-slate-200">
      {
        platform.offers.map((offer) => (
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 px-5 py-4 last:border-b-0">
            <div>
              <p class="font-medium text-slate-900">{offer.model}</p>
              <p class="mt-0.5 text-sm text-slate-500">{offer.quota}</p>
            </div>
            <span class="rounded-md bg-emerald-600/10 px-2.5 py-1 text-xs font-medium text-emerald-700">
              {OFFER_TYPE_LABEL[offer.type] ?? offer.type}
            </span>
          </div>
        ))
      }
    </div>

    <!-- 领取步骤 -->
    <h2 id="steps" class="mt-10 scroll-mt-24 text-xl font-bold text-slate-900">领取步骤</h2>
    <ol class="mt-4 space-y-3">
      {
        platform.steps.map((step, i) => (
          <li class="flex gap-3 rounded-xl border border-slate-200 bg-white p-4">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">
              {i + 1}
            </span>
            <span class="text-sm leading-relaxed text-slate-700">{step}</span>
          </li>
        ))
      }
    </ol>

    <!-- 怎么用 -->
    {
      platform.api_base && (
        <div>
          <h2 id="usage" class="mt-10 scroll-mt-24 text-xl font-bold text-slate-900">怎么用</h2>
          {isOpenAI && (
            <p class="mt-2 text-sm text-slate-500">
              接口兼容 OpenAI 格式。base_url：<code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">{platform.api_base}</code>
              示例模型：<code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">{platform.example_model}</code>（可用模型以官方列表为准）
            </p>
          )}
          {!isOpenAI && (
            <p class="mt-2 text-sm text-slate-500">
              接口为官方自有协议，<strong class="font-semibold text-slate-700">不兼容 OpenAI SDK</strong>。接入端点：<code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">{platform.api_base}</code>
              示例模型：<code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">{platform.example_model}</code>（鉴权方式与可用模型以官方文档为准）
            </p>
          )}
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            <div>
              <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">cURL</p>
              <pre class="overflow-x-auto rounded-xl bg-slate-900 p-4 text-xs leading-relaxed text-slate-100"><code>{curlExample}</code></pre>
            </div>
            <div>
              <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">{isOpenAI ? 'Python（openai SDK）' : 'Python（官方 SDK）'}</p>
              <pre class="overflow-x-auto rounded-xl bg-slate-900 p-4 text-xs leading-relaxed text-slate-100"><code>{pythonExample}</code></pre>
            </div>
          </div>
          <p class="mt-3 text-sm text-slate-500">
            喜欢图形界面？看教程<a href="/tutorials/cherry-studio-setup/" class="font-medium text-emerald-700 hover:underline">《领取第一个免费 Key 并接入 Cherry Studio》</a>。
            API 文档：<a href={platform.docs_url} target="_blank" rel="noopener noreferrer" class="font-medium text-emerald-700 hover:underline">{platform.docs_url} ↗</a>
          </p>
        </div>
      )
    }

    {
      platform.extra_endpoints && platform.extra_endpoints.length > 0 && (
        <div>
          <h2 id="endpoints" class="mt-10 scroll-mt-24 text-xl font-bold text-slate-900">附加端点</h2>
          <p class="mt-2 text-sm text-slate-500">部分套餐（如 Coding Plan）有专用接入端点，配置时注意区分：</p>
          <div class="mt-4 overflow-hidden rounded-xl border border-slate-200">
            {
              platform.extra_endpoints.map((ep) => (
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 px-5 py-3 last:border-b-0">
                  <span class="text-sm font-medium text-slate-700">{ep.name}</span>
                  <code class="rounded bg-slate-100 px-2 py-0.5 text-xs">{ep.url}</code>
                </div>
              ))
            }
          </div>
        </div>
      )
    }

    <!-- 官方开发工具 -->
    {
      platform.devAgent && (
        <div class="mt-10">
          <h2 id="devagent" class="scroll-mt-24 text-xl font-bold text-slate-900">🛠️ 官方开发工具</h2>
          <div class="mt-4 rounded-xl border border-slate-200 bg-white p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="max-w-xl">
                <p class="font-semibold text-slate-900">{platform.devAgent.name}</p>
                <p class="mt-1 text-sm leading-relaxed text-slate-600">{platform.devAgent.note}</p>
              </div>
              <a
                href={platform.devAgent.url}
                target="_blank"
                rel="noopener noreferrer"
                class="shrink-0 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700"
              >
                前往 {platform.devAgent.name.split('（')[0]} ↗
              </a>
            </div>
            <p class="mt-3 text-xs text-amber-600">⚠️ 该工具赠送的额度通常为产品内额度，不可导出为 API Key。</p>
          </div>
        </div>
      )
    }

    <!-- 坑点 -->
    <div id="pitfalls" class="mt-10 scroll-mt-24">
      <Callout type="warn" title="坑点提醒">
        <ul class="list-disc space-y-1 pl-4">
          {platform.pitfalls.map((pit) => <li>{pit}</li>)}
        </ul>
      </Callout>
    </div>

    <!-- 相关活动：进行中 -->
    {
      activeDeals.length > 0 && (
        <div class="mt-10">
          <h2 id="active" class="scroll-mt-24 text-xl font-bold text-slate-900">📌 进行中活动</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {activeDeals.map((deal) => (
              <DealCard deal={deal} />
            ))}
          </div>
        </div>
      )
    }

    <!-- 相关活动：历史（已归档） -->
    {
      endedDeals.length > 0 && (
        <div class="mt-10">
          <h2 id="archived" class="scroll-mt-24 flex items-center gap-2 text-xl font-bold text-slate-900">
            🗄️ 历史活动
            <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500">已归档</span>
          </h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {endedDeals.map((deal) => (
              <DealCard deal={deal} />
            ))}
          </div>
        </div>
      )
    }

    <!-- 上下篇 -->
    <div class="mt-12 flex justify-between border-t border-slate-100 pt-6 text-sm">
      <a href={`/models/${prev.slug}/`} class="text-emerald-700 hover:underline">← {prev.name}</a>
      <a href={`/models/${next.slug}/`} class="text-emerald-700 hover:underline">{next.name} →</a>
    </div>
      </section>

      <!-- 右侧目录导航（TOC，仅 lg+ 显示） -->
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">目录</p>
          <nav>
            <ul class="space-y-2 text-sm">
              {toc.map((t) => (
                <li>
                  <a data-toc-id={t.id} href={`#${t.id}`} class="block text-slate-500 transition hover:text-emerald-700">{t.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>
    </div>
  </div>

  <style is:global>
    html { scroll-behavior: smooth; }
  </style>

  <script>
    const links = Array.from(document.querySelectorAll('[data-toc-id]'));
    if (links.length) {
      const setActive = (id) => {
        links.forEach((l) => {
          const on = l.getAttribute('data-toc-id') === id;
          l.classList.toggle('text-emerald-700', on);
          l.classList.toggle('font-semibold', on);
        });
      };
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => { if (e.isIntersecting) setActive(e.target.id); });
        },
        { rootMargin: '-72px 0px -70% 0px', threshold: 0 }
      );
      links.forEach((l) => {
        const el = document.getElementById(l.getAttribute('data-toc-id'));
        if (el) observer.observe(el);
      });
      setActive(links[0].getAttribute('data-toc-id'));
    }
  </script>
</Base>
