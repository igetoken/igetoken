---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import Callout from '../../components/Callout.astro';
import StarRating from '../../components/StarRating.astro';
import DealCard from '../../components/DealCard.astro';
import { getAllPlatforms, getPlatforms, getPlatformBySlug, getDealsByPlatform, OFFER_TYPE_LABEL, CATEGORY_LABEL } from '../../lib/data';

export function getStaticPaths() {
  return getAllPlatforms().map((platform) => ({
    params: { slug: platform.slug },
    props: { platform },
  }));
}

const { platform } = Astro.props as { platform: ReturnType<typeof getPlatformBySlug> };
const relatedDeals = getDealsByPlatform(platform.slug);
const activeDeals = relatedDeals.filter((d) => d.status !== 'ended');
const endedDeals = relatedDeals.filter((d) => d.status === 'ended');
const all = getAllPlatforms();
const idx = all.findIndex((p) => p.slug === platform.slug);
const prev = all[(idx - 1 + all.length) % all.length];
const next = all[(idx + 1) % all.length];
const verifiedShort = platform.last_verified.replace(/-/g, '/');

// 一键分享卡片所需数据（序列化进客户端脚本，避免运行时跨域加载）
const shareUrl = `https://igetoken.com/models/${platform.slug}/`;
const shareData = {
  name: platform.name,
  tagline: platform.tagline,
  slug: platform.slug,
  category: platform.category,
  hasApi: !!platform.api_base,
  openai: platform.openai_compatible !== false && !!platform.api_base,
  tags: platform.tags ?? [],
  offers: platform.offers.map((o) => ({ model: o.model, quota: o.quota })),
  url: shareUrl,
};

// 步骤文本中的 http(s) 链接自动转可点击 <a>（排除中文/半角括号、常见中文标点，避免把包围符号吞进 URL）
const linkify = (text: string): string =>
  text.replace(
    /(https?:\/\/[^\s<>"'\uFF08\uFF09\uFF0C\u3001\u3002()]+)/g,
    '<a href="$1" target="_blank" rel="noopener noreferrer" class="text-emerald-600 underline decoration-emerald-300/70 hover:text-emerald-700">$1</a>'
  );

const isOpenAI = platform.openai_compatible !== false;
// 自定义认证头（如 Dots 用 api-key 替代默认 Authorization: Bearer）
const authHeaderName = platform.authHeader ?? 'Authorization';
const isCustomAuth = authHeaderName !== 'Authorization';

const curlExample = isOpenAI
  ? `curl ${platform.api_base}/chat/completions \\
  -H "Content-Type: application/json" \\
  -H "${authHeaderName}${isCustomAuth ? '' : ': Bearer'}: $API_KEY" \\
  -d '{
    "model": "${platform.example_model}",
    "messages": [{"role": "user", "content": "你好，介绍一下你自己"}]
  }'`
  : `# 该平台使用官方自有协议，不支持 cURL 直连
# 接入端点：${platform.api_base}
# 完整文档：${platform.docs_url}`;

const pythonExample = isOpenAI
  ? (isCustomAuth
      ? `from openai import OpenAI
import os

client = OpenAI(
    api_key="placeholder",  # 占位；实际认证走下方自定义请求头
    default_headers={"${authHeaderName}": os.environ["API_KEY"]},
    base_url="${platform.api_base}",
)

resp = client.chat.completions.create(
    model="${platform.example_model}",
    messages=[{"role": "user", "content": "你好，介绍一下你自己"}],
)
print(resp.choices[0].message.content)`
      : `from openai import OpenAI
import os

client = OpenAI(
    api_key=os.environ["API_KEY"],
    base_url="${platform.api_base}",
)

resp = client.chat.completions.create(
    model="${platform.example_model}",
    messages=[{"role": "user", "content": "你好，介绍一下你自己"}],
)
print(resp.choices[0].message.content)`)
  : (platform.sdk_example ?? `# 该平台需使用官方 SDK 调用，详见 ${platform.docs_url}`);

// 右侧目录（TOC）：与下方区块渲染同源，条件区块自动出现/消失
const toc = [
  { id: 'offers', label: '额度速览' },
  { id: 'steps', label: '领取步骤' },
  platform.api_base ? { id: 'usage', label: '怎么用' } : null,
  platform.extra_endpoints && platform.extra_endpoints.length > 0 ? { id: 'endpoints', label: '附加端点' } : null,
  platform.devAgent ? { id: 'devagent', label: '官方开发工具' } : null,
  { id: 'pitfalls', label: '坑点提醒' },
  activeDeals.length > 0 ? { id: 'active', label: '进行中活动' } : null,
  endedDeals.length > 0 ? { id: 'archived', label: '历史活动' } : null,
].filter(Boolean);

---

<Base
  title={`${platform.name} 免费 Token 领取攻略（2026 最新） | iGetToken`}
  description={`${platform.name}：${platform.highlight}。附领取步骤、调用示例、坑点提醒，最后核实于 ${verifiedShort}。`}
>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-10">
      <section class="min-w-0">
    <nav class="text-sm text-slate-400">
      <a href="/models/" class="hover:text-emerald-700">资源库</a>
      <span class="mx-1">/</span>
      <span class="text-slate-600">{CATEGORY_LABEL[platform.category]}</span>
    </nav>

    {
      platform.status === 'ended' && (
        <Callout type="danger" title="该平台已停服归档">
          <p>{platform.name} 已停止服务，本页仅作历史归档保留，相关免费额度已不可用；如需使用请移步其他在架平台。</p>
        </Callout>
      )
    }

    <!-- 头部 -->
    <div class="mt-4 flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-black text-slate-900">{platform.name}</h1>
        <p class="mt-2 text-slate-500">{platform.tagline}</p>
        {
          platform.rating ? (
            <div class="mt-3 flex flex-wrap items-center gap-2">
              <StarRating rating={platform.rating} label />
              {platform.ratingNote && <span class="text-sm text-slate-500">{platform.ratingNote}</span>}
            </div>
          ) : null
        }
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <Badge variant="verified" label={`${verifiedShort} 已核实`} />
        <button
          id="share-card-btn"
          type="button"
          class="rounded-lg border border-emerald-600 px-4 py-2 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-50"
        >
          分享卡片
        </button>
        <a
          href={platform.website}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700"
        >
          前往官方平台 ↗
        </a>
      </div>
    </div>

    <!-- 额度速览 -->
    <h2 id="offers" class="mt-10 scroll-mt-24 text-xl font-bold text-slate-900">额度速览</h2>
    <div class="mt-4 overflow-hidden rounded-xl border border-slate-200">
      {
        platform.offers.map((offer) => (
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 px-5 py-4 last:border-b-0">
            <div>
              <p class="font-medium text-slate-900">{offer.model}</p>
              <p class="mt-0.5 text-sm text-slate-500">{offer.quota}</p>
            </div>
            <span class="rounded-md bg-emerald-600/10 px-2.5 py-1 text-xs font-medium text-emerald-700">
              {OFFER_TYPE_LABEL[offer.type] ?? offer.type}
            </span>
          </div>
        ))
      }
    </div>

    <!-- 领取步骤 -->
    <h2 id="steps" class="mt-10 scroll-mt-24 text-xl font-bold text-slate-900">领取步骤</h2>
    <ol class="mt-4 space-y-3">
      {
        platform.steps.map((step, i) => (
          <li class="flex gap-3 rounded-xl border border-slate-200 bg-white p-4">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">
              {i + 1}
            </span>
            <span class="text-sm leading-relaxed text-slate-700" set:html={linkify(step)}></span>
          </li>
        ))
      }
    </ol>

    <!-- 怎么用 -->
    {
      platform.api_base && (
        <div>
          <h2 id="usage" class="mt-10 scroll-mt-24 text-xl font-bold text-slate-900">怎么用</h2>
          {isOpenAI && (
            <p class="mt-2 text-sm text-slate-500">
              接口兼容 OpenAI 格式。base_url：<code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">{platform.api_base}</code>
              示例模型：<code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">{platform.example_model}</code>（可用模型以官方列表为准）
              {isCustomAuth && <span class="ml-1 text-amber-600">⚠️ 认证请求头为 <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">{authHeaderName}</code>，非标准 Authorization: Bearer</span>}
            </p>
          )}
          {!isOpenAI && (
            <p class="mt-2 text-sm text-slate-500">
              接口为官方自有协议，<strong class="font-semibold text-slate-700">不兼容 OpenAI SDK</strong>。接入端点：<code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">{platform.api_base}</code>
              示例模型：<code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">{platform.example_model}</code>（鉴权方式与可用模型以官方文档为准）
            </p>
          )}
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            <div>
              <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">cURL</p>
              <pre class="overflow-x-auto rounded-xl bg-slate-900 p-4 text-xs leading-relaxed text-slate-100"><code>{curlExample}</code></pre>
            </div>
            <div>
              <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">{isOpenAI ? 'Python（openai SDK）' : 'Python（官方 SDK）'}</p>
              <pre class="overflow-x-auto rounded-xl bg-slate-900 p-4 text-xs leading-relaxed text-slate-100"><code>{pythonExample}</code></pre>
            </div>
          </div>
          <p class="mt-3 text-sm text-slate-500">
            喜欢图形界面？看教程<a href="/tutorials/cherry-studio-setup/" class="font-medium text-emerald-700 hover:underline">《领取第一个免费 Key 并接入 Cherry Studio》</a>。
            API 文档：<a href={platform.docs_url} target="_blank" rel="noopener noreferrer" class="font-medium text-emerald-700 hover:underline">{platform.docs_url} ↗</a>
          </p>
        </div>
      )
    }

    {
      platform.extra_endpoints && platform.extra_endpoints.length > 0 && (
        <div>
          <h2 id="endpoints" class="mt-10 scroll-mt-24 text-xl font-bold text-slate-900">附加端点</h2>
          <p class="mt-2 text-sm text-slate-500">部分套餐（如 Coding Plan）有专用接入端点，配置时注意区分：</p>
          <div class="mt-4 overflow-hidden rounded-xl border border-slate-200">
            {
              platform.extra_endpoints.map((ep) => (
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 px-5 py-3 last:border-b-0">
                  <span class="text-sm font-medium text-slate-700">{ep.name}</span>
                  <code class="rounded bg-slate-100 px-2 py-0.5 text-xs">{ep.url}</code>
                </div>
              ))
            }
          </div>
        </div>
      )
    }

    <!-- 官方开发工具 -->
    {
      platform.devAgent && (
        <div class="mt-10">
          <h2 id="devagent" class="scroll-mt-24 text-xl font-bold text-slate-900">🛠️ 官方开发工具</h2>
          <div class="mt-4 rounded-xl border border-slate-200 bg-white p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="max-w-xl">
                <p class="font-semibold text-slate-900">{platform.devAgent.name}</p>
                <p class="mt-1 text-sm leading-relaxed text-slate-600">{platform.devAgent.note}</p>
              </div>
              <a
                href={platform.devAgent.url}
                target="_blank"
                rel="noopener noreferrer"
                class="shrink-0 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700"
              >
                前往 {platform.devAgent.name.split('（')[0]} ↗
              </a>
            </div>
            <p class="mt-3 text-xs text-amber-600">⚠️ 该工具赠送的额度通常为产品内额度，不可导出为 API Key。</p>
          </div>
        </div>
      )
    }

    <!-- 坑点 -->
    <div id="pitfalls" class="mt-10 scroll-mt-24">
      <Callout type="warn" title="坑点提醒">
        <ul class="list-disc space-y-1 pl-4">
          {platform.pitfalls.map((pit) => <li>{pit}</li>)}
        </ul>
      </Callout>
    </div>

    <!-- 相关活动：进行中 -->
    {
      activeDeals.length > 0 && (
        <div class="mt-10">
          <h2 id="active" class="scroll-mt-24 text-xl font-bold text-slate-900">📌 进行中活动</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {activeDeals.map((deal) => (
              <DealCard deal={deal} />
            ))}
          </div>
        </div>
      )
    }

    <!-- 相关活动：历史（已归档） -->
    {
      endedDeals.length > 0 && (
        <div class="mt-10">
          <h2 id="archived" class="scroll-mt-24 flex items-center gap-2 text-xl font-bold text-slate-900">
            🗄️ 历史活动
            <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500">已归档</span>
          </h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {endedDeals.map((deal) => (
              <DealCard deal={deal} />
            ))}
          </div>
        </div>
      )
    }

    <!-- 上下篇 -->
    <div class="mt-12 flex justify-between border-t border-slate-100 pt-6 text-sm">
      <a href={`/models/${prev.slug}/`} class="text-emerald-700 hover:underline">← {prev.name}</a>
      <a href={`/models/${next.slug}/`} class="text-emerald-700 hover:underline">{next.name} →</a>
    </div>
      </section>

      <!-- 右侧目录导航（TOC，仅 lg+ 显示） -->
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">目录</p>
          <nav>
            <ul class="space-y-2 text-sm">
              {toc.map((t) => (
                <li>
                  <a data-toc-id={t.id} href={`#${t.id}`} class="block toc-link">{t.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>
    </div>
  </div>

  <style is:global>
    html { scroll-behavior: smooth; }
    .toc-link {
      border-left: 2px solid transparent;
      padding-left: 0.75rem;
      color: #64748b; /* slate-500 */
      transition: color .15s ease, border-color .15s ease;
    }
    .toc-link:hover { color: #047857; } /* emerald-700 */
    .toc-link.is-active {
      border-left-color: #059669; /* emerald-600 品牌色 */
      color: #047857; /* emerald-700 */
      font-weight: 600;
    }
    #share-modal {
      position: fixed; inset: 0; z-index: 60; padding: 16px;
      display: none; align-items: center; justify-content: center;
      background: rgba(15, 23, 42, 0.6);
    }
    #share-modal.open { display: flex; }
    #share-modal .panel {
      width: 100%; max-width: 640px; background: #fff;
      border-radius: 16px; padding: 16px;
    }
    #share-modal canvas { width: 100%; height: auto; border-radius: 12px; display: block; }
    #share-modal .actions { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 8px; }
    #share-modal .actions button {
      flex: 1 1 auto; min-width: 120px; text-align: center;
      border-radius: 10px; padding: 10px 12px; font-size: 14px; font-weight: 600; cursor: pointer;
    }
    #share-modal .btn-primary { background: #059669; color: #fff; border: none; }
    #share-modal .btn-ghost { background: #fff; color: #059669; border: 1px solid #059669; }
    #share-modal .btn-close { background: #f1f5f9; color: #475569; border: none; }
    #share-toast {
      position: fixed; left: 50%; bottom: 32px; transform: translateX(-50%);
      background: #0f172a; color: #fff; padding: 10px 16px; border-radius: 999px;
      font-size: 13px; opacity: 0; transition: opacity .2s; pointer-events: none; z-index: 70;
    }
    #share-toast.show { opacity: 1; }
  </style>

  <script>
    const links = Array.from(document.querySelectorAll('[data-toc-id]'));
    if (links.length) {
      const setActive = (id) => {
        links.forEach((l) => {
          const on = l.getAttribute('data-toc-id') === id;
          l.classList.toggle('is-active', on);
        });
      };
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => { if (e.isIntersecting) setActive(e.target.id); });
        },
        { rootMargin: '-72px 0px -70% 0px', threshold: 0 }
      );
      links.forEach((l) => {
        const el = document.getElementById(l.getAttribute('data-toc-id'));
        if (el) observer.observe(el);
      });
      setActive(links[0].getAttribute('data-toc-id'));
    }
  </script>

  <div id="share-modal" aria-hidden="true">
    <div class="panel">
      <canvas id="share-canvas" width="600" height="824"></canvas>
      <div class="actions">
        <button id="share-copy-img" class="btn-primary" type="button">复制图片</button>
        <button id="share-download" class="btn-ghost" type="button">下载 PNG</button>
        <button id="share-copy-link" class="btn-ghost" type="button">复制链接</button>
        <button id="share-close" class="btn-close" type="button">关闭</button>
      </div>
    </div>
  </div>
  <div id="share-toast"></div>

  <script define:vars={{ shareData }}>
    // 二维码用构建期预生成的同源静态图（public/share/qr-site.png），避免运行时 import 裸模块名导致加载失败
    const data = shareData;
    const modal = document.getElementById('share-modal');
    const canvas = document.getElementById('share-canvas');
    const openBtn = document.getElementById('share-card-btn');
    const closeBtn = document.getElementById('share-close');
    const copyImgBtn = document.getElementById('share-copy-img');
    const dlBtn = document.getElementById('share-download');
    const copyLinkBtn = document.getElementById('share-copy-link');
    const toastEl = document.getElementById('share-toast');
    const F = 'system-ui, "PingFang SC", "Microsoft YaHei", sans-serif';

    function toast(msg){ toastEl.textContent = msg; toastEl.classList.add('show'); setTimeout(()=>toastEl.classList.remove('show'), 1900); }
    function rr(ctx,x,y,w,h,r){
      ctx.beginPath();
      ctx.moveTo(x+r,y);
      ctx.arcTo(x+w,y,x+w,y+h,r);
      ctx.arcTo(x+w,y+h,x,y+h,r);
      ctx.arcTo(x,y+h,x,y,r);
      ctx.arcTo(x,y,x+w,y,r);
      ctx.closePath();
    }
    function rrTop(ctx,x,y,w,h,r){
      ctx.beginPath();
      ctx.moveTo(x+r,y);
      ctx.arcTo(x+w,y,x+w,y+h,r);
      ctx.arcTo(x+w,y+h,x,y+h,0);
      ctx.arcTo(x,y+h,x,y,0);
      ctx.arcTo(x,y,x+w,y,r);
      ctx.closePath();
    }
    function fit(ctx,text,maxW,start,min){
      let s=start;
      while(s>min){ ctx.font=`600 ${s}px ${F}`; if(ctx.measureText(text).width<=maxW) break; s-=2; }
      return s;
    }
    function buildTags(){
      const set=new Set();
      (data.tags||[]).slice(0,3).forEach(t=>set.add(t));
      if(data.category==='domestic') set.add('国内直连');
      if(data.openai) set.add('OpenAI 兼容');
      if(data.category==='aggregator') set.add('聚合路由');
      set.add('免费 API');
      return Array.from(set).slice(0,4);
    }
    function trunc(ctx,text,maxW){
      if(ctx.measureText(text).width<=maxW) return text;
      let t=text;
      while(t.length>4 && ctx.measureText(t+'…').width>maxW) t=t.slice(0,-1);
      return t+'…';
    }

    async function buildCard(){
      const dpr=Math.min(window.devicePixelRatio||1,2);
      const W=600,H=824;
      canvas.width=W*dpr; canvas.height=H*dpr;
      const ctx=canvas.getContext('2d');
      ctx.setTransform(dpr,0,0,dpr,0,0);
      ctx.clearRect(0,0,W,H);
      ctx.fillStyle='#ffffff'; rr(ctx,0,0,W,H,28); ctx.fill();
      ctx.fillStyle='#059669'; rrTop(ctx,0,0,W,108,28); ctx.fill();
      ctx.fillStyle='#ffffff'; ctx.beginPath(); ctx.arc(46,54,22,0,Math.PI*2); ctx.fill();
      ctx.fillStyle='#059669'; ctx.font=`600 18px ${F}`; ctx.textAlign='left'; ctx.textBaseline='middle'; ctx.fillText('iG',36,55);
      ctx.fillStyle='#ffffff'; ctx.font=`600 22px ${F}`; ctx.fillText('iGetToken',80,48);
      ctx.fillStyle='rgba(255,255,255,0.82)'; ctx.font=`13px ${F}`; ctx.fillText('免费 LLM Token 导航',80,72);
      ctx.fillStyle='#0f172a'; ctx.textBaseline='alphabetic';
      const ns=fit(ctx,data.name,512,30,20); ctx.font=`600 ${ns}px ${F}`;
      let ny=162;
      if(data.name.length>15){
        const mid=Math.ceil(data.name.length/2);
        ctx.fillText(data.name.slice(0,mid),40,ny);
        ctx.fillText(data.name.slice(mid),40,ny+ns+8);
        ny+=ns*2+14;
      } else { ctx.fillText(data.name,40,ny); ny+=ns+20; }
      ctx.fillStyle='#64748b'; ctx.font=`13px ${F}`;
      ctx.fillText(trunc(ctx,data.tagline||'',520),40,ny);
      let ty=ny+30; const tags=buildTags(); let tx=40; ctx.font=`500 13px ${F}`;
      for(const tag of tags){
        const tw=ctx.measureText(tag).width+24;
        if(tx+tw>560) break;
        ctx.fillStyle='#ecfdf5'; rr(ctx,tx,ty,tw,30,15); ctx.fill();
        ctx.fillStyle='#047857'; ctx.fillText(tag,tx+12,ty+20);
        tx+=tw+8;
      }
      let my=ty+58; ctx.fillStyle='#94a3b8'; ctx.font=`600 12px ${F}`; ctx.fillText('免费模型',40,my);
      my+=8;
      for(const o of (data.offers||[]).slice(0,4)){
        const bh=64;
        ctx.fillStyle='#f0fdf9'; rr(ctx,40,my,520,bh,14); ctx.fill();
        ctx.fillStyle='#0f172a'; ctx.font=`500 15px ${F}`;
        ctx.fillText(trunc(ctx,o.model,470),56,my+26);
        ctx.fillStyle='#059669'; ctx.font=`12px ${F}`;
        let q1=(o.quota||'').split(/[，。；;]/)[0]; if(q1.length>46) q1=q1.slice(0,45)+'…';
        ctx.fillText(trunc(ctx,q1,470),56,my+46);
        my+=bh+10;
      }
      ctx.strokeStyle='#e2e8f0'; ctx.beginPath(); ctx.moveTo(40,my+6); ctx.lineTo(560,my+6); ctx.stroke();
      const fy=my+32;
      ctx.fillStyle='#0f172a'; ctx.font=`600 16px ${F}`; ctx.fillText('igetoken.com/models/'+data.slug,40,fy);
      ctx.fillStyle='#64748b'; ctx.font=`12px ${F}`; ctx.fillText('扫码访问 iGetToken · 长按复制分享好友',40,fy+22);
      const img=new Image();
      img.onerror=()=>{ img.onerror=null; img.src='/share/qr-site.png'; };
      img.src=`/share/qr/${data.slug}.png`;
      await new Promise(res=>{ img.onload=res; img.onerror=res; });
      ctx.drawImage(img,452,fy-18,108,108);
    }

    async function openModal(){
      openBtn.disabled=true; const t=openBtn.textContent; openBtn.textContent='生成中…';
      try{ await buildCard(); }catch(e){ console.error('share card build failed',e); }
      modal.classList.add('open'); modal.setAttribute('aria-hidden','false');
      openBtn.disabled=false; openBtn.textContent=t;
    }
    function closeModal(){ modal.classList.remove('open'); modal.setAttribute('aria-hidden','true'); }
    function blob(){ return new Promise(res=>canvas.toBlob(res,'image/png')); }
    function download(){ blob().then(b=>{ if(!b) return; const a=document.createElement('a'); a.href=URL.createObjectURL(b); a.download=`igetoken-${data.slug}.png`; a.click(); URL.revokeObjectURL(a.href); toast('已下载 PNG'); }); }

    openBtn.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', e=>{ if(e.target===modal) closeModal(); });
    document.addEventListener('keydown', e=>{ if(e.key==='Escape' && modal.classList.contains('open')) closeModal(); });
    copyImgBtn.addEventListener('click', async ()=>{
      const b=await blob(); if(!b) return;
      try{
        if(navigator.clipboard && window.ClipboardItem){
          await navigator.clipboard.write([new ClipboardItem({'image/png':b})]);
          toast('卡片图片已复制，去粘贴吧');
        } else throw new Error('no clipboard image');
      }catch(err){ download(); toast('当前浏览器不支持复制图片，已改为下载'); }
    });
    dlBtn.addEventListener('click', download);
    copyLinkBtn.addEventListener('click', ()=>{ navigator.clipboard.writeText(data.url).then(()=>toast('链接已复制')).catch(()=>toast('复制失败，请手动复制')); });
  </script>
</Base>
