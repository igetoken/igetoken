---
import Base from '../layouts/Base.astro';
---

<Base title="页面未找到 | iGetToken" description="你访问的页面不存在。">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="text-6xl font-black text-emerald-600">404</p>
    <h1 class="mt-4 text-2xl font-bold text-slate-900">这个页面不存在</h1>
    <p class="mt-2 text-slate-500">可能链接已过期，或者页面还在路上。</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-xl bg-emerald-600 px-6 py-3 font-semibold text-white hover:bg-emerald-700">
        回首页
      </a>
      <a href="/models/" class="rounded-xl border border-slate-300 px-6 py-3 font-semibold text-slate-700 hover:border-emerald-400">
        去领免费 Token
      </a>
    </div>
  </section>
</Base>
