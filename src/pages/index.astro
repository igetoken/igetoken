---
import Base from '../layouts/Base.astro';
import PlatformCard from '../components/PlatformCard.astro';
import DealCard from '../components/DealCard.astro';
import FilterTabs from '../components/FilterTabs.astro';
import { getPlatforms, getActiveDeals, getEndedDeals, sortDealsByUrgency, CATEGORY_LABEL } from '../lib/data';

const platforms = getPlatforms();
const recentDeals = sortDealsByUrgency([...getActiveDeals(), ...getEndedDeals()]).slice(0, 8);
const groups = (Object.keys(CATEGORY_LABEL) as (keyof typeof CATEGORY_LABEL)[]).map(
  (key) => ({ key, label: CATEGORY_LABEL[key] })
);
const lastVerified = platforms
  .map((p) => p.last_verified)
  .sort()
  .at(-1);
---

<Base
  title="iGetToken - 2026 全网最全 AI 大模型免费 Token 白嫖指南 & 实操教程"
  description="拒绝割韭菜！只收录官方正规渠道的免费大模型 API 与 Token 福利：注册赠送、永久免费模型、限时活动快讯每日更新，附保姆级领取与使用教程。"
>
  <!-- Hero -->
  <section class="border-b border-slate-100 bg-gradient-to-b from-emerald-50 via-white to-white">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center md:py-24">
      <p class="inline-flex items-center gap-2 rounded-full bg-emerald-600/10 px-4 py-1.5 text-sm font-medium text-emerald-700">
        🔍 只收录官方正规渠道 · 每日人工核实
      </p>
      <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-black leading-tight text-slate-900 md:text-5xl">
        2026 全网最全 AI 大模型<br class="hidden md:block" />
        <span class="text-emerald-600">免费 Token</span> 白嫖指南
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-500">
        拒绝割韭菜！注册赠送、永久免费模型、限时活动，一站收齐，附保姆级使用教程。
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/models/"
          class="rounded-xl bg-emerald-600 px-6 py-3 font-semibold text-white shadow-sm transition hover:bg-emerald-700"
        >
          领取免费 Token
        </a>
        <a
          href="/deals/"
          class="rounded-xl border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-700 transition hover:border-emerald-400 hover:text-emerald-700"
        >
          🔥 限时活动快讯
        </a>
      </div>
      <p class="mt-6 text-xs text-slate-400">内容最后核实：{lastVerified} · 额度以各官方页面为准</p>
    </div>
  </section>

  <!-- 最新活动快讯 -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <div class="flex items-end justify-between">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">🔥 最新活动快讯</h2>
        <p class="mt-1 text-sm text-slate-500">限时福利、价格变动、免费上新，及时速报</p>
      </div>
      <a href="/deals/" class="text-sm font-medium text-emerald-700 hover:underline">查看全部 →</a>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {recentDeals.map((deal) => <DealCard deal={deal} />)}
    </div>
  </section>

  <!-- 资源库 -->
  <section class="border-y border-slate-100 bg-slate-50/60">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">免费资源库</h2>
          <p class="mt-1 text-sm text-slate-500">共收录 {platforms.length} 个平台，持续扩充中</p>
        </div>
        <FilterTabs targetId="home-models" groups={groups} />
      </div>
      <div id="home-models" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          platforms.map((p) => (
            <div data-category={p.category}>
              <PlatformCard platform={p} />
            </div>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-slate-400">
        待收录：SambaNova
      </p>
    </div>
  </section>

  <!-- 精选教程 -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <div class="flex items-end justify-between">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">保姆级教程</h2>
        <p class="mt-1 text-sm text-slate-500">从「怎么领」到「怎么用」，手把手带你跑通</p>
      </div>
      <a href="/tutorials/" class="text-sm font-medium text-emerald-700 hover:underline">全部教程 →</a>
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {
        [
          {
            href: '/tutorials/cherry-studio-setup/',
            emoji: '🔑',
            title: '领取第一个免费 Key 并接入 Cherry Studio',
            desc: '以智谱 GLM-4-Flash 为例，注册、领额度、配置客户端一气呵成。',
          },
          {
            href: '/tutorials/python-call-api/',
            emoji: '🐍',
            title: '用 Python 三行代码调用免费大模型',
            desc: 'OpenAI SDK 兼容写法，一套代码随便切换免费平台。',
          },
          {
            href: '/tutorials/choose-free-platform/',
            emoji: '🧭',
            title: '2026 免费 API 平台怎么选',
            desc: '按场景对号入座：学习、高频轻任务、长文本、多模态各选谁。',
          },
        ].map((t) => (
          <a
            href={t.href}
            class="rounded-xl border border-slate-200 bg-white p-6 transition hover:border-emerald-300 hover:shadow-md"
          >
            <span class="text-3xl">{t.emoji}</span>
            <h3 class="mt-3 font-bold text-slate-900">{t.title}</h3>
            <p class="mt-2 text-sm text-slate-500">{t.desc}</p>
          </a>
        ))
      }
    </div>
  </section>
</Base>
