---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { webPageNode, topLevelBreadcrumb, itemListNode } from '../../lib/schema';

const tutorials = (await getCollection('tutorials')).sort((a, b) => {
  const av = (a.data.updatedAt ?? a.data.pubDate).valueOf();
  const bv = (b.data.updatedAt ?? b.data.pubDate).valueOf();
  if (bv !== av) return bv - av; // 更新日期优先
  const ap = a.data.pubDate.valueOf();
  const bp = b.data.pubDate.valueOf();
  if (bp !== ap) return bp - ap;
  return a.id.localeCompare(b.id); // 兜底，保证顺序稳定
});
const formatDate = (d: Date) => d.toISOString().slice(0, 10);

const pageUrl = '/tutorials/';
const pageTitle = '保姆级教程 - 免费 Token 从领取到调用 | iGetoken';
const pageDesc =
  '从领 Key、配客户端到写代码，再到报错排查与多模型容灾：免费大模型 API 的完整教程系列，含可运行代码与跨平台排错对照。';
const pageSchema = [
  webPageNode({ url: pageUrl, name: '保姆级教程', description: pageDesc, type: 'CollectionPage' }),
  topLevelBreadcrumb(pageUrl, '教程'),
  itemListNode({
    url: pageUrl,
    name: '免费大模型 API 教程',
    items: tutorials.map((t) => ({ name: t.data.title, url: `/tutorials/${t.id}/` })),
  }),
];
---

<Base title={pageTitle} description={pageDesc} schema={pageSchema}>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-black text-slate-900">保姆级教程</h1>
    <p class="mt-2 text-slate-500">从「怎么领」到「怎么用」，每一步都有截图级细节。</p>

    <div class="mt-8 space-y-4">
      {
        tutorials.map((t) => (
          <a
            href={`/tutorials/${t.id}/`}
            class="block rounded-xl border border-slate-200 bg-white p-6 transition hover:border-emerald-300 hover:shadow-md"
          >
            <div class="flex flex-wrap items-center gap-2 text-xs text-slate-400">
              <time datetime={formatDate(t.data.pubDate)}>{formatDate(t.data.pubDate)}</time>
              {t.data.updatedAt && (
                <span class="rounded-md bg-emerald-50 px-2 py-0.5 text-emerald-700">
                  更新于 {formatDate(t.data.updatedAt)}
                </span>
              )}
              {t.data.tags.map((tag) => (
                <span class="rounded-md bg-slate-100 px-2 py-0.5 text-slate-600">{tag}</span>
              ))}
            </div>
            <h2 class="mt-2 text-lg font-bold text-slate-900">{t.data.title}</h2>
            <p class="mt-1.5 text-sm text-slate-500">{t.data.description}</p>
          </a>
        ))
      }
    </div>

    <p class="mt-8 text-sm text-slate-400">
      教程只讲方法与口径，具体的免费额度、截止日期一律以
      <a href="/models/" class="font-medium text-emerald-700 hover:underline">资源库</a>
      各平台页为准（每页都标注了核实日期）。
    </p>
  </section>
</Base>
